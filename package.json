{
  "name": "protothon-backend",
  "version": "1.0.0",
  "description": "FirstStepHack Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "env-cmd -e local tsx watch src/index.ts",
    "dev:development": "env-cmd -e development tsx watch src/index.ts",
    "build": "tsc",
    "build:render": "npm install --include=dev && npm run build",
    "start": "env-cmd -e production node dist/index.js",
    "start:render": "node dist/index.js",
    "seed": "env-cmd -e development tsx src/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-oauth2-jwt-bearer": "^1.9.0",
    "firebase": "^10.12.0",
    "firebase-admin": "^12.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "env-cmd": "^10.1.0",
    "tsx": "^4.19.0"
  }
}
