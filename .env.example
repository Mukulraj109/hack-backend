# Optional overrides only — npm scripts load env from .env-cmdrc.json:
#   npm run dev   → development (FirstStep USA dev MongoDB Atlas)
#   npm start     → production  (FirstStep USA prod MongoDB Atlas)
#
# Copy to .env only if you need to override a single value locally.
# Do not commit .env with real secrets.

PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
AUTH0_DOMAIN=auth.firststepjob.com
AUTH0_CLIENT_ID=
CORS_ORIGIN=http://localhost:5173
ZOHO_WEBHOOK_SECRET=
# Server-only — never expose to the frontend bundle
ZOHO_REGISTRATION_FORM_URL=
ZOHO_FOLLOW_FORM_URL=
ZOHO_HIRING_PARTNER_FORM_URL=
ZOHO_INFO_SESSION_FORM_URL=
ZOHO_SOCIAL_SHARE_FORM_URL=
# Dual-platform form — LinkedIn Field_7/8, Instagram Field_9/10 (defaults match render.yaml)
# ZOHO_SOCIAL_WEBHOOK_FIELD_LINKEDIN_POST_URL=Field_7
# ZOHO_SOCIAL_WEBHOOK_FIELD_LINKEDIN_SCREENSHOT=Field_8
# ZOHO_SOCIAL_WEBHOOK_FIELD_INSTAGRAM_POST_URL=Field_9
# ZOHO_SOCIAL_WEBHOOK_FIELD_INSTAGRAM_SCREENSHOT=Field_10
SKIP_FIREBASE=true
# ZeptoMail — registration approval emails (server-only)
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_APPROVAL_TEMPLATE_KEY=
# Exact key from ZeptoMail template → Merge info tab (if auto-detection fails)
# ZEPTOMAIL_APPROVAL_MERGE_FIRSTNAME_KEY=name_firstname
ZEPTOMAIL_FROM_ADDRESS=noreply@firststepjob.com
ZEPTOMAIL_FROM_NAME=FirstStep
# Team reminder emails (daily cron for users without a team)
ZEPTOMAIL_TEAM_REMINDER_TEMPLATE_KEY=
TEAM_REMINDER_CRON_ENABLED=true
TEAM_REMINDER_CRON_SCHEDULE=0 10 * * *
TEAM_REMINDER_MIN_HOURS_AFTER_ACTIVE=48
TEAM_REMINDER_MIN_HOURS_BETWEEN_SENDS=24
# Claim 50 points emails (immediate on team join + daily cron)
ZEPTOMAIL_CLAIM_POINTS_TEMPLATE_KEY=
CLAIM_POINTS_REMINDER_CRON_ENABLED=true
CLAIM_POINTS_REMINDER_CRON_SCHEDULE=0 11 * * *
CLAIM_POINTS_REMINDER_MIN_HOURS_BETWEEN_SENDS=24
# Score update emails (admin actions that increase score)
ZEPTOMAIL_SCORE_UPDATE_TEMPLATE_KEY=
HACKATHON_DASHBOARD_URL=
# Per-track brief URLs (optional; returned by GET /api/config/tracks)
# TRACK_BRIEF_URL_PREDICTIVE_CAREER_INTELLIGENCE=
# TRACK_BRIEF_URL_JOB_MARKET_VISUALIZED=
# TRACK_BRIEF_URL_SMART_APPLICATION_TRACKER=
# TRACK_BRIEF_URL_DEPLOY_AT_SCALE=
# TRACK_BRIEF_URL_SECURE_BY_DEFAULT=
