# Optional overrides only — npm scripts load env from .env-cmdrc.json:
#   npm run dev   → development (FirstStep USA dev MongoDB Atlas)
#   npm start     → production  (FirstStep USA prod MongoDB Atlas)
#
# Copy to .env only if you need to override a single value locally.
# Do not commit .env with real secrets.

PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
AUTH0_DOMAIN=auth.firststepjob.com
AUTH0_CLIENT_ID=
CORS_ORIGIN=http://localhost:5173
ZOHO_WEBHOOK_SECRET=
SKIP_FIREBASE=true
