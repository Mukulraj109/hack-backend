# Optional overrides only — npm scripts load env from .env-cmdrc.json:
#   npm run dev   → development (FirstStep USA dev MongoDB Atlas)
#   npm start     → production  (FirstStep USA prod MongoDB Atlas)
#
# Copy to .env only if you need to override a single value locally.
# Do not commit .env with real secrets.

PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
AUTH0_DOMAIN=auth.firststepjob.com
AUTH0_CLIENT_ID=
CORS_ORIGIN=http://localhost:5173
ZOHO_WEBHOOK_SECRET=
# Server-only — never expose to the frontend bundle
ZOHO_REGISTRATION_FORM_URL=
ZOHO_FOLLOW_FORM_URL=
ZOHO_HIRING_PARTNER_FORM_URL=
ZOHO_INFO_SESSION_FORM_URL=
ZOHO_SOCIAL_SHARE_FORM_URL=
# Optional — when Zoho webhook uses Field_1…Field_N keys (defaults: Field_5, Field_7, Field_8)
# ZOHO_SOCIAL_WEBHOOK_FIELD_PLATFORM=Field_5
# ZOHO_SOCIAL_WEBHOOK_FIELD_POST_URL=Field_7
# ZOHO_SOCIAL_WEBHOOK_FIELD_SCREENSHOT=Field_8
SKIP_FIREBASE=true
